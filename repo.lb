def init(repo):
    repo.name = "embr"
    repo.description = "General purpose embedded library with a focus on robotics"


def prepare(repo, options):
    # modm is not loaded from here: projects list modm/repo.lb alongside this repo in their
    # project.xml, and embr modules depend on the modm modules they need directly.
    repo.find_modules_recursive("./build-tools", modulefile="*.lb")
    repo.find_modules_recursive("./src", modulefile="*.lb")


def build(env):
    pass
