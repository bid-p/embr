def init(module):
    module.name = ":build-tools"
    module.description = "SCons files required to build an embr project"


def prepare(module, options):
    module.depends("modm:build", "modm:build:scons")
    return True


def build(env):
    # modm:build:scons generates modm/SConscript and embr/SConscript; this adds the project-level
    # SConstruct that ties them together with the application sources in src/
    env.outbasepath = "."
    env.substitutions = {"project_name": env["modm:build:project.name"]}
    env.template("Sconstruct.in", "Sconstruct")

    env.outbasepath = "build_tools"
    env.copy("parse_args.py")
