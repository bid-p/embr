import os
import shutil
import subprocess
import sys
from multiprocessing import cpu_count
from os.path import join, abspath

from SCons.Script import *

from build_tools import compile_db, parse_args

PROJECT_NAME = "{{ project_name }}"
BUILD_PATH = "build"
SRC_PATH = "src"

# Generated by lbuild: modm/SConscript and embr/SConscript each build a static library
LIBRARY_PATHS = ["modm", "embr"]
LINKERSCRIPT_FILE = abspath("modm/link/linkerscript.ld")

# J-Link Commander: found on PATH, via JLINK_PATH, or at SEGGER's default Windows install location
JLINK_DEFAULT_PATH = "C:/Program Files/SEGGER/JLink/JLink.exe"
JLINK_SPEED_KHZ = 4000


def find_jlink():
    for candidate in (os.environ.get("JLINK_PATH"), shutil.which("JLink"), shutil.which("JLinkExe"),
                      JLINK_DEFAULT_PATH):
        if candidate and os.path.isfile(candidate):
            return candidate
    return None


def program_jlink(env, source):
    """Flashes a .hex with J-Link Commander, then resets and runs the target."""

    def call_program_jlink(target, source, env):
        jlink = find_jlink()
        if jlink is None:
            print("J-Link Commander not found. Add the SEGGER J-Link folder to PATH or set JLINK_PATH.")
            return 1

        hex_file = abspath(str(source[0]))
        script = join(env["CONFIG_BUILD_BASE"], "program.jlink")
        with open(script, "w") as f:
            # By default J-Link clears DEMCR.TRCENA on disconnect, which stops the DWT cycle counter that
            # modm::delay spins on, hanging the application until the next power cycle.
            f.write("exec SetSkipDebugDeInit = 1\n")
            f.write(f"r\nh\nloadfile \"{hex_file}\"\nr\ng\nqc\n")

        return subprocess.call([
            jlink, "-device", env.subst("$MODM_JLINK_DEVICE"), "-if", "SWD",
            "-speed", str(JLINK_SPEED_KHZ), "-autoconnect", "1", "-NoGui", "1",
            "-ExitOnError", "1", "-CommandFile", script,
        ])

    return env.AlwaysBuild(env.Alias("program-jlink", source, call_program_jlink))


args = parse_args.parse_args()

env = DefaultEnvironment(ENV=os.environ)
env["CONFIG_BUILD_BASE"] = abspath(join(BUILD_PATH, args["TARGET_ENV"]))
env["CONFIG_PROJECT_NAME"] = PROJECT_NAME
env["CONFIG_ARTIFACT_PATH"] = join(env["CONFIG_BUILD_BASE"], "artifact")
env["CONFIG_PROFILE"] = args["BUILD_PROFILE"]

# Building all libraries (modm must be first, since it sets up the toolchain)
env.SConscript(dirs=LIBRARY_PATHS, exports=["env"])

if GetOption("num_jobs") == 1:
    SetOption("num_jobs", max(cpu_count() - 1, 1))
print("Configured {0} parallel build jobs (-j{0})".format(GetOption("num_jobs")))

if sys.platform == "win32":
    import subprocess

    def win32_spawn_via_popen(_sh, _escape, cmd, args, env):
        # Blind argument concatenation is generally dangerous but args seem to already come in
        # escaped+quoted.
        # "args" is intended to be the target's argv, and thus the first entry is the program name
        # itself. We strip this and replace it with the explicit target command before passing it to
        # Popen. Windows will internally compute an appropriate argv.
        concatenated_args = " ".join(args[1:])
        command_with_args = cmd + " " + concatenated_args

        # Provided shell and escape function are ignored. It is not clear under what cases scons
        # uses the features of a host shell so it's unused for simplicity.

        proc = subprocess.Popen(
            command_with_args,
            stdin=None,
            stdout=None,
            stderr=None,
            shell=False,
            env=env
        )
        _stdout, _stderr = proc.communicate()
        status_code = proc.wait()
        return status_code

    env["SPAWN"] = win32_spawn_via_popen

# References:
#   GCC flags: https://gcc.gnu.org/onlinedocs/gcc/Option-Summary.html
#   Scons API: https://www.scons.org/doc/latest/HTML/scons-user/apa.html
#
# You can append one or multiple options like this
#     env.Append(CCFLAGS="-pedantic")
#     env.Append(CCFLAGS=["-pedantic", "-pedantic-errors"])
# If you need to remove options, you need to do this:
#     env["CCFLAGS"].remove("-pedantic")
# Note that a lot of options also have a "-no-{option}" option
# that may overwrite previous options.

# Add build-specific flags
if args["BUILD_PROFILE"] == "debug":
    env.AppendUnique(CCFLAGS=["-fno-inline"])
elif args["BUILD_PROFILE"] == "fast":
    if "-g3" in env["CCFLAGS"]:
        env["CCFLAGS"].remove("-g3")
    env.AppendUnique(CCFLAGS=["-O0"])
elif args["BUILD_PROFILE"] == "release":
    # Replace -Os with -O2
    if "-Os" in env["CCFLAGS"]:
        env["CCFLAGS"].remove("-Os")
    env.AppendUnique(CCFLAGS=["-O2"])

# Add profiling-specific flags
if args["PROFILING"] == "true":
    env.AppendUnique(CPPFLAGS=["-DRUN_WITH_PROFILING"])

env.AppendUnique(CCFLAGS=["-Wno-misleading-indentation"])

# Add any additional flags the user chooses specify
if "additional-ccflags" in ARGUMENTS:
    env.AppendUnique(CCFLAGS=[*ARGUMENTS["additional-ccflags"].split(",")])

# Absolute, because SCons resolves a relative CPPPATH against the directory of the SConscript that builds each
# file: modm and embr sources would get modm/src and embr/src instead. Library configuration headers that
# live in the application (e.g. FatFs' <ffconf_local.h>) rely on it.
env.AppendUnique(CPPPATH=[abspath(SRC_PATH)])

sources = env.FindSourceFiles(SRC_PATH)

# building for hardware
if args["TARGET_ENV"] == "hardware":
    print(f"\nBuilding for hardware environment with profile \"{args['BUILD_PROFILE']}\"\n")

    program = env.Program(target=env["CONFIG_PROJECT_NAME"] + ".elf", source=sources)

    # The executable depends on the linkerscript
    env.Depends(target=program, dependency=LINKERSCRIPT_FILE)

    # Add target environment-specific SCons aliases
    # WARNING: all aliases must be checked during argument validation
    # compile_commands.json for clangd, regenerated on every build so it follows new sources
    def write_compile_db(target, source, env):
        # Every source gets the include path added to CPPPATH above
        count = compile_db.generate(args["BUILD_PROFILE"], [SRC_PATH], include_dirs=[SRC_PATH])
        print(f"Compile DB······ compile_commands.json ({count} sources)")

    compile_db_action = env.Action(write_compile_db, cmdstr=None)
    compile_db_alias = env.AlwaysBuild(env.Alias("compile_db", [], compile_db_action))
    env.Alias("build", [program, compile_db_alias])
    env.Alias("size", env.Size(program))
    env.Alias("gdb", env.DebugGdbRemote(program))
    if args["PROBE"] == "jlink":
        env.Alias("run", program_jlink(env, env.Hex(program)))
    else:
        env.Alias("run", [env.ProgramOpenOcd(program)])
    env.Alias("all", ["build", "size"])
    env.Default("all")  # For the hardware target env, "all" runs if you don't
                        # specify anything (i.e. just type "scons")
else:
    print("Not sure how you made it here, target environment not supported in SConstruct.")
    exit(1)
