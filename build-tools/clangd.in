# Generated by embr:build-tools. compile_commands.json (written by `scons build`) supplies the compile
# flags; this file only adjusts what clangd reports.

# modm evaluates floor()/round() in constant expressions, which GCC allows as an extension but clang
# cannot, e.g. computeDelayMhz() in modm/platform/clock/rcc.cpp. Hidden only in generated modm code, so
# the same diagnostics still show up in application code.
If:
  PathMatch: modm/.*
Diagnostics:
  Suppress:
    - require_constant_init_failed
    - constexpr_var_requires_const_init
