<library>
    <repositories>
        <repository><path>../embr/modm/repo.lb</path></repository>
        <repository><path>../embr/repo.lb</path></repository>
    </repositories>

    <options>
        <option name="modm:build:project.name">project-name</option>
        <!-- embr generates its own Sconstruct -->
        <option name="modm:build:scons:include_sconstruct">False</option>

        <!-- Either set a target MCU for a custom board... -->
        <option name="modm:target">stm32g431rbt6</option>
    </options>

    <modules>
        <!-- ...or remove modm:target and use a modm board module instead -->
        <!-- <module>modm:board:nucleo-g431rb</module> -->

        <module>modm:platform:core</module>
        <module>modm:platform:gpio</module>
        <module>modm:architecture:delay</module>

        <module>embr:core</module>
    </modules>
</library>
