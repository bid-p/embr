def init(module):
    module.name = ":counter"
    module.description = "Saturating counters that report reaching a threshold"


def prepare(module, options):
    return True


def build(env):
    env.outbasepath = "embr/src/emlib/counter"
    env.copy("counter.hpp")

    env.collect("modm:build:path.include", "embr/src")
